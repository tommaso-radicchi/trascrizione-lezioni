[Unit]
Description=Trascrizione Lezioni - loop dell'Orchestratore
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/tommy/Progetti/trascrizione-lezioni
Environment=PATH=/home/tommy/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/tommy/.local/bin/uv run python -m trascrizione_lezioni.orchestratore_run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
